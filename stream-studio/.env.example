# Stream Studio — server-side environment (copy to .env, never commit .env)

# TikTok LIVE data API (public demo key is the default fallback).
# TIKTOOL_API_KEY=

# AI host (Tarogo) — Bearer token for https://api.tarogo.ai/chat/completions.
# Required for the "AI host sapa penonton & balas komentar" feature (IKI-40/IKI-47).
# Keep this secret: it is read server-side only and is never shipped to the
# client bundle or the published overlay URL.
TAROGO_API_KEY=

# Optional override of the Tarogo chat-completions endpoint.
# TAROGO_API_ENDPOINT=https://api.tarogo.ai/chat/completions
